#!/usr/bin/make -f
D = $(CURDIR)/debian/{{ package_name }}

%:
	dh $@

override_dh_auto_install:
	install -Dm755 pipewire/esp32dif-sink $(D)/usr/bin/esp32dif-sink
	install -d $(D)/usr/lib/systemd/user
	sed 's|%h/.local/bin/|/usr/bin/|' pipewire/esp32dif-sink.service > $(D)/usr/lib/systemd/user/esp32dif-sink.service
