# Maintainer: {{ maintainer }}
pkgname={{ package_name }}
pkgver={{ version }}
pkgrel=1
pkgdesc="{{ description }}"
arch=('any')
url="{{ homepage }}"
license=('GPL-3.0-or-later')
depends=({{ runtime_dependencies | join: ' ' }})
source=("{{ source_folder_name }}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/{{ source_folder_name }}"
  install -Dm755 tools/esp32dif-sink "$pkgdir/usr/bin/esp32dif-sink"
  install -d "$pkgdir/usr/lib/systemd/user/pipewire.service.wants"
  sed 's|%h/.local/bin/|/usr/bin/|' tools/esp32dif-sink.service > "$pkgdir/usr/lib/systemd/user/esp32dif-sink.service"
  ln -s ../esp32dif-sink.service "$pkgdir/usr/lib/systemd/user/pipewire.service.wants/esp32dif-sink.service"
}
