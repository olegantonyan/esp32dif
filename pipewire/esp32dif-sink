#!/bin/bash
# Usage: pipewire/esp32dif-sink [host] [rate] [format]   e.g. pipewire/esp32dif-sink esp32dif.local 48000 S24BE
# Defaults come from SPDIF_HOST, SPDIF_RATE, SPDIF_FORMAT, SPDIF_PASSWORD, SPDIF_REMOTE (the service reads them from ~/.config/esp32dif-sink.conf)
set -u

host=${1:-${SPDIF_HOST:-esp32dif.local}}
rate=${2:-${SPDIF_RATE:-48000}}
format=${3:-${SPDIF_FORMAT:-S24BE}}
port=${SPDIF_PORT:-5004}
sap_port=${SPDIF_SAP_PORT:-9875}
check_s=${SPDIF_CHECK_S:-10}
misses=${SPDIF_MISSES:-3}
password=${SPDIF_PASSWORD:-esp32dif-admin}
remote=${SPDIF_REMOTE:-1}
remote_port=${SPDIF_REMOTE_PORT:-5005}

conf=$(mktemp --suffix=.conf)
pid=
remote_pid=
stop_sink() {
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
    fi
    pid=
}
trap 'stop_sink; [ -z "$remote_pid" ] || kill "$remote_pid" 2>/dev/null; rm -f "$conf"' EXIT
trap 'exit 0' INT TERM

resolve() { getent ahostsv4 "$host" | awk 'NR == 1 { print $1 }'; }
lease() {
    printf 'user = "admin:%s"\n' "$(printf %s "$password" | sed 's/[\\"]/\\&/g')" | curl -s -o /dev/null -w '%{http_code}' -m 3 -K - -X POST "http://$1/api/rtp/allow"
}
denied=
alive() {
    code=$(lease "$1")
    if [ "$code" = 401 ]; then
        [ -n "$denied" ] || echo "esp32dif-sink: $host rejected the password, set SPDIF_PASSWORD"
        denied=1
    else
        denied=
    fi
    [ "$code" = 200 ]
}
nap() { sleep "$check_s" & wait $!; }

mpris() {
    playerctl "$1" 2>/dev/null || echo "esp32dif-sink: remote $1: no media player"
}

send_tracks() {
    local line
    while IFS= read -r line; do
        printf 'track %s\n' "$line" || return
    done
}

track_pid=
stop_track() {
    if [ -n "$track_pid" ]; then
        kill "$track_pid" 2>/dev/null
        wait "$track_pid" 2>/dev/null
    fi
    track_pid=
}

remote_loop() {
    trap 'stop_track; exit 0' TERM
    local ip= reply= action= connected= refused=
    while :; do
        ip=$(resolve)
        if [ -n "$ip" ] && exec 3<>"/dev/tcp/$ip/$remote_port" 2>/dev/null; then
            printf '%s\n' "$password" >&3
            reply=
            if read -r -t 5 reply <&3 && [ "$reply" = ok ]; then
                [ -n "$connected" ] || echo "esp32dif-sink: remote buttons connected"
                connected=1
                refused=
                playerctl --follow metadata --format $'{{trunc(artist,60)}}\t{{trunc(title,60)}}' 2>/dev/null > >(send_tracks >&3) &
                track_pid=$!
                while read -r -t 75 action <&3; do
                    case $action in
                        previous|play-pause|next) mpris "$action" ;;
                    esac
                done
                stop_track
            elif [ "$reply" = denied ] && [ -z "$refused" ]; then
                refused=1
                echo "esp32dif-sink: $host rejected the password for remote buttons, set SPDIF_PASSWORD"
            fi
            exec 3<&-
        fi
        nap
    done
}

write_conf() {
    cat > "$conf" <<EOF
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-rtp-sap
        args = {
            sap.ip = "$1"
            sap.port = $sap_port
        }
    }
    { name = libpipewire-module-rtp-sink
        args = {
            destination.ip = "$1"
            destination.port = $port
            sess.media = "audio"
            audio.format = "$format"
            audio.rate = $rate
            audio.channels = 2
            audio.position = [ FL FR ]
            stream.props = {
                media.class = "Audio/Sink"
                node.name = "esp32dif-rtp"
                node.group = "pipewire.dummy"
                node.description = "S/PDIF over Wi-Fi ($host)"
                sess.sap.announce = true
            }
        }
    }
]
EOF
}

if [ "$remote" = 1 ]; then
    remote_loop &
    remote_pid=$!
fi

waiting=
while :; do
    ip=$(resolve)
    if [ -z "$ip" ] || ! alive "$ip"; then
        [ -n "$waiting" ] || echo "esp32dif-sink: waiting for $host (mDNS + HTTP every $check_s s)"
        waiting=1
        nap
        continue
    fi
    waiting=
    write_conf "$ip"
    echo "esp32dif-sink: $host is $ip, sending $format $rate Hz to UDP $port"
    PIPEWIRE_DEBUG=${PIPEWIRE_DEBUG:-W,mod.rtp-sap:E} pipewire -c "$conf" &
    pid=$!
    missed=0
    while kill -0 "$pid" 2>/dev/null; do
        nap
        if alive "$ip"; then missed=0; else missed=$((missed + 1)); fi
        if [ "$missed" -ge "$misses" ]; then
            echo "esp32dif-sink: $host stopped answering, removing the sink"
            break
        fi
        now=$(resolve)
        if [ -n "$now" ] && [ "$now" != "$ip" ]; then
            echo "esp32dif-sink: $host moved to $now"
            break
        fi
    done
    stop_sink
done
